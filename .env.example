# Clé de signature des sessions (JWT). OBLIGATOIRE en production.
# Générer une valeur aléatoire de 32+ caractères, par ex. :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=changez-cette-valeur-par-une-chaine-aleatoire-de-32-caracteres-minimum

# URL publique du site (utilisée pour les métadonnées Open Graph)
NEXT_PUBLIC_SITE_URL=https://imf-immobilere.tn

# PostgreSQL : active le stockage distant ; migrer/importer la base avant déploiement.
DATABASE_URL=
# PG_SSL_CA_FILE=C:/chemin/certificat-ca.pem
