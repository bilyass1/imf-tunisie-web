# Clé de signature des sessions (JWT). OBLIGATOIRE en production.
# Générer une valeur aléatoire de 32+ caractères, par ex. :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=changez-cette-valeur-par-une-chaine-aleatoire-de-32-caracteres-minimum

# URL publique du site (utilisée pour les métadonnées Open Graph)
NEXT_PUBLIC_SITE_URL=https://imf-immobilere.tn

# PostgreSQL : active le stockage distant ; migrer/importer la base avant déploiement.
DATABASE_URL=
# PG_SSL_CA_FILE=C:/chemin/certificat-ca.pem

# New contract uploads require an antivirus service in production. Existing files remain readable.
# CLAMAV_HOST=your-private-scanner-host
# CLAMAV_PORT=3310
# CLAMAV_TLS=1
# Optional HTTPS CDN for approved public assets; never used for private client media.
# NEXT_PUBLIC_ASSET_ORIGIN=https://assets.your-domain.example
# One-time first-admin provisioning only: npm run admin:create (refuses existing admins).
# Supply IMF_ADMIN_EMAIL and IMF_ADMIN_PASSWORD privately in the command environment.

# Exact origin, also checked for WebAuthn and authenticated POST endpoints.
APP_ORIGIN=https://imf-immobilere.tn
# Required for anonymous login/contact in production. Configure ONLY after the
# reverse proxy strips incoming values and sets ONE verified IP (not a chain).
# TRUSTED_CLIENT_IP_HEADER=x-real-ip
# First passkey for each existing administrator: supply a random private token
# >=32 characters to the operator and set it temporarily, then remove it.
# ADMIN_PASSKEY_ENROLLMENT_TOKEN=
# Extra exact HTTPS origins required by legitimate image/fetch integrations.
# CSP_ALLOWED_ORIGINS=https://specific-host.example
# Optional private S3-compatible media store (never public ACLs).
# MEDIA_S3_BUCKET=
# MEDIA_S3_REGION=us-east-1
# MEDIA_S3_ENDPOINT=https://private-object-storage.example
# MEDIA_S3_PATH_STYLE=1
# Use workload credentials or AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY privately.

# Filled and reviewed operator release evidence file, kept outside Git.
# RELEASE_EVIDENCE_FILE=/private/release-evidence.json

# PostgreSQL total connection budget: instances × per-instance pool <= budget - reserve.
# DATABASE_URL should point to the provider's transaction pooler when autoscaling.
PG_POOL_MAX=3
PG_MAX_INSTANCES=1
PG_CONNECTION_BUDGET=100
PG_CONNECTION_RESERVE=20
PG_CONNECT_TIMEOUT_MS=5000
# Optional anonymous 10% Web Vitals sample. Honors Do Not Track; no full URLs/IDs.
# Apply migration 007 and schedule npm run metrics:prune daily before enabling.
NEXT_PUBLIC_WEB_VITALS_ENABLED=0
