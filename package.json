{
  "name": "imf-tunisie-web",
  "version": "1.0.0",
  "private": true,
  "description": "Site web + espace client IMF \u2014 Immobili\u00e8re Mseddi Fr\u00e8res",
  "scripts": {
    "prebuild": "node scripts/prepare-public-assets.mjs && node scripts/prepare-web-documents.mjs",
    "assets:prepare": "node scripts/prepare-public-assets.mjs",
    "audit:property": "node scripts/audit-property-launch.cjs",
    "test:property": "node scripts/test-property-search.cjs && node scripts/test-visit-leads.cjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src scripts --quiet",
    "typecheck": "tsc --noEmit",
    "plans": "node scripts/generate-plans.mjs",
    "test": "node scripts/test-yassamine-picking.cjs && node scripts/test-yassamine-a5a-facts.cjs && node scripts/test-yassamine-a5b.cjs && node scripts/test-yassamine-a6.cjs && node scripts/test-property-search.cjs && node scripts/test-visit-leads.cjs && node scripts/test-commercial.cjs && node scripts/test-pwa.cjs && node scripts/test-lot-composition.cjs && node scripts/test-storage.cjs && node scripts/test-security-postgres.cjs && node scripts/test-postgres-runtime.cjs && node scripts/test-audit-security.cjs",
    "db:check": "node scripts/postgres.cjs check",
    "db:migrate": "node scripts/postgres.cjs migrate",
    "db:import": "node scripts/postgres.cjs import",
    "db:validate": "node scripts/postgres.cjs validate",
    "admin:create": "node scripts/create-admin.cjs",
    "assets:web-documents": "node scripts/prepare-web-documents.mjs",
    "predev": "node scripts/prepare-public-assets.mjs && node scripts/prepare-web-documents.mjs",
    "ops:check": "node scripts/check-production.cjs",
    "test:e2e": "playwright test",
    "test:hardening": "node scripts/test-hardening.cjs",
    "catalog:seed": "node scripts/catalog-seed.cjs",
    "check:sources": "node scripts/check-source-policy.cjs"
  },
