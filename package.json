{
  "name": "imf-tunisie-web",
  "version": "1.0.0",
  "private": true,
  "description": "Site web + espace client IMF — Immobilière Mseddi Frères",
  "scripts": {
    "prebuild": "node scripts/prepare-public-assets.mjs",
    "assets:prepare": "node scripts/prepare-public-assets.mjs",
    "audit:property": "node scripts/audit-property-launch.cjs",
    "test:property": "node scripts/test-property-search.cjs && node scripts/test-visit-leads.cjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "plans": "node scripts/generate-plans.mjs",
    "test": "node scripts/test-yassamine-picking.cjs && node scripts/test-yassamine-a5a-facts.cjs && node scripts/test-yassamine-a5b.cjs && node scripts/test-yassamine-a6.cjs && node scripts/test-property-search.cjs && node scripts/test-visit-leads.cjs && node scripts/test-commercial.cjs && node scripts/test-pwa.cjs && node scripts/test-storage.cjs && node scripts/test-security-postgres.cjs && node scripts/test-postgres-runtime.cjs",
    "db:check": "node scripts/postgres.cjs check",
    "db:migrate": "node scripts/postgres.cjs migrate",
    "db:import": "node scripts/postgres.cjs import",
    "db:validate": "node scripts/postgres.cjs validate"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/functions": "^3.9.8",
    "bcryptjs": "2.4.3",
    "jose": "5.9.6",
    "next": "^15.5.25",
    "pg": "^8.23.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "sharp": "^0.35.4",
    "three": "^0.171.0"
  },
  "devDependencies": {
