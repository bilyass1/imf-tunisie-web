    "@types/bcryptjs": "2.4.6",
    "@types/node": "22.10.7",
    "@types/pg": "^8.23.1",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "@types/three": "^0.171.0",
    "autoprefixer": "10.4.20",
    "postcss": "8.5.28",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.3"
  },
  "overrides": {
    "postcss": "8.5.28"
  }
}
