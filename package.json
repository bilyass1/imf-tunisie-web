    "@simplewebauthn/server": "^14.0.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/functions": "^3.9.8",
    "bcryptjs": "2.4.3",
    "ipaddr.js": "^2.5.0",
    "jose": "5.9.6",
    "next": "^15.5.28",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "sharp": "^0.35.5",
    "three": "^0.171.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.64.1",
    "@types/bcryptjs": "2.4.6",
    "@types/node": "22.10.7",
    "@types/pg": "^8.23.1",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "@types/three": "^0.171.0",
    "autoprefixer": "10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.25",
    "postcss": "8.5.28",
    "tailwindcss": "3.4.19",
    "typescript": "5.7.3"
  },
  "overrides": {
    "postcss": "8.5.28",
    "postcss-selector-parser": "7.1.6"
  }
}
